NODE_ENV=development
PORT=3000

# --- IA (obligatoria para chat, visión y voz) ---
OPENAI_API_KEY=

# --- Sesiones (obligatoria en producción) ---
JWT_SECRET=

# --- Base de datos (sin esto no hay cuentas, planes ni leads) ---
DATABASE_URL=

# --- Precio mostrado del plan PRO ---
PRO_PRECIO_ETIQUETA=
PRO_MONEDA=
PRO_IMPORTE=

# --- Pasarela de pago (pendiente de conectar) ---
# PAYMENT_PROVIDER=stripe|mercadopago
PAYMENT_API_KEY=
PAYMENT_PRICE_ID=
PAYMENT_WEBHOOK_SECRET=

# --- Panel interno: alta manual de planes y listado de leads ---
# Sin este valor, /api/admin/plan y GET /api/leads devuelven 404.
ADMIN_TOKEN=

# --- Modelos (opcionales) ---
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE=alloy
